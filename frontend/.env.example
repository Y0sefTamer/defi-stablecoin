# ---------------------------------------------------------------------------
# Public, client-visible values only. Never put a private key or a secret API
# key here: everything prefixed with NEXT_PUBLIC_ ships to the browser.
#
# Copy this file to .env.local and fill in what you need.
# ---------------------------------------------------------------------------

# RPC endpoints. The defaults in src/config/chains.ts are public nodes.
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional explicit engine addresses. Leave empty to use
# src/config/deployments.generated.json (written by `pnpm sync:deployments`
# from the Foundry broadcast artifact).
NEXT_PUBLIC_DSC_ENGINE_31337=
NEXT_PUBLIC_DSC_ENGINE_11155111=

# Block the engine was deployed at. Needed to scan history for activity and
# liquidatable accounts. `pnpm sync:deployments` fills this in automatically.
NEXT_PUBLIC_DEPLOYMENT_BLOCK_31337=
NEXT_PUBLIC_DEPLOYMENT_BLOCK_11155111=

# eth_getLogs window size. Lower it if your RPC provider rejects ranges.
NEXT_PUBLIC_LOG_CHUNK_SIZE=10000
